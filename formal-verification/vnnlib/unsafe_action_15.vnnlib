; Counterexample query for unsafe scheduling action 15
;
; X_0 = normalized eMBB load
; X_1 = normalized URLLC load
; X_2 = normalized mMTC load
; Y_i = Q-value for action i

(declare-const X_0 Real)
(declare-const X_1 Real)
(declare-const X_2 Real)

(declare-const Y_0 Real)
(declare-const Y_1 Real)
(declare-const Y_2 Real)
(declare-const Y_3 Real)
(declare-const Y_4 Real)
(declare-const Y_5 Real)
(declare-const Y_6 Real)
(declare-const Y_7 Real)
(declare-const Y_8 Real)
(declare-const Y_9 Real)
(declare-const Y_10 Real)
(declare-const Y_11 Real)
(declare-const Y_12 Real)
(declare-const Y_13 Real)
(declare-const Y_14 Real)
(declare-const Y_15 Real)
(declare-const Y_16 Real)
(declare-const Y_17 Real)
(declare-const Y_18 Real)
(declare-const Y_19 Real)
(declare-const Y_20 Real)
(declare-const Y_21 Real)

; Input domain
(assert (>= X_0 0.0))
(assert (<= X_0 1.0))
(assert (>= X_1 0.002))
(assert (<= X_1 1.0))
(assert (>= X_2 0.0))
(assert (<= X_2 1.0))

; Unsafe condition: action 15 can be an argmax
(assert (>= Y_15 Y_0))
(assert (>= Y_15 Y_1))
(assert (>= Y_15 Y_2))
(assert (>= Y_15 Y_3))
(assert (>= Y_15 Y_4))
(assert (>= Y_15 Y_5))
(assert (>= Y_15 Y_6))
(assert (>= Y_15 Y_7))
(assert (>= Y_15 Y_8))
(assert (>= Y_15 Y_9))
(assert (>= Y_15 Y_10))
(assert (>= Y_15 Y_11))
(assert (>= Y_15 Y_12))
(assert (>= Y_15 Y_13))
(assert (>= Y_15 Y_14))
(assert (>= Y_15 Y_16))
(assert (>= Y_15 Y_17))
(assert (>= Y_15 Y_18))
(assert (>= Y_15 Y_19))
(assert (>= Y_15 Y_20))
(assert (>= Y_15 Y_21))
